{
  "manifest_version": 3,
  "name": "OpenBrowser",
  "version": "1.2.0",
  "description": "Open-source browser automation for AI agents. Side-panel UI plus an MCP server for Claude Code, opencode, and anything else that speaks MCP.",
  "minimum_chrome_version": "116",

  "permissions": [
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "sidePanel",
    "downloads",
    "webNavigation",
    "cookies",
    "alarms",
    "clipboardWrite"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },

  "action": {
    "default_title": "OpenBrowser",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "options/options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/a11y.js", "content/actions.js", "content/main.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["content/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Open the OpenBrowser panel"
    }
  }
}
