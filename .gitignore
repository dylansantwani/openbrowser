.env
.env.*
!.env.example
*.key
*.pem

# ─── Local editor / agent settings ────────────────────────────
.claude/settings.local.json

# ─── OS / editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
